# ============================================
# CorpusAI - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Add pooling params in production (Railway/PgBouncer). Tune connection_limit per
# service: API higher (concurrent requests), worker lower (concurrency 3).
DATABASE_URL="postgresql://user:password@localhost:5432/corpusai?schema=public&connection_limit=10&pool_timeout=20"

# ============================================
# AUTHENTICATION (Better Auth)
# ============================================
BETTER_AUTH_SECRET="your-secret-key-min-32-chars-here"
BETTER_AUTH_URL="http://localhost:3001"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============================================
# AI / LLM
# ============================================
OPENAI_API_KEY="sk-..."

# Optional: Anthropic for Claude (future support)
ANTHROPIC_API_KEY=""

# Optional: Mistral for Mistral Large/Small
MISTRAL_API_KEY=""

# ============================================
# VECTOR DATABASE (Qdrant)
# ============================================
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# ============================================
# APPLICATION
# ============================================
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# ============================================
# STRIPE BILLING (required for paid plans)
# ============================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_CREATOR_MONTHLY=""
STRIPE_PRICE_CREATOR_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_YEARLY=""

# ============================================
# MONITORING (optional)
# ============================================
# Sentry error tracking — leave empty to disable
SENTRY_DSN=""
# Required only to upload source maps in CI
SENTRY_AUTH_TOKEN=""

# ============================================
# STORAGE (optional - for document uploads)
# ============================================
# S3-compatible storage
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
