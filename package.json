{
  "name": "corpusai",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev dev:studio",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "worker:dev": "pnpm --filter @corpusai/ai-worker dev",
    "worker:start": "pnpm --filter @corpusai/ai-worker start",
    "db:studio": "pnpm --filter @corpusai/database db:studio",
    "db:generate": "pnpm --filter @corpusai/database db:generate",
    "db:push": "pnpm --filter @corpusai/database db:push",
    "db:migrate": "pnpm --filter @corpusai/database db:migrate",
    "db:migrate:prod": "pnpm --filter @corpusai/database db:migrate:prod",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
