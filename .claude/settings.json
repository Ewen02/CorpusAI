{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm outdated:*)",
      "Bash(npx prisma:*)",
      "Bash(nest:*)",
      "Bash(tsx:*)",
      "Bash(turbo:*)",
      "Bash(docker:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm exec:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; npx prettier --write \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | grep -qE '(\\.env$|\\.env\\.local$|pnpm-lock\\.yaml$)' && echo '{\"continue\": false, \"stopReason\": \"Blocked: editing .env, .env.local, or pnpm-lock.yaml is not allowed\"}' || exit 0"
          }
        ]
      }
    ]
  }
}
