# ============================================
# CorpusAI API - Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/corpusai?schema=public"

# Authentication
BETTER_AUTH_SECRET="your-secret-key-min-32-chars-here"
BETTER_AUTH_URL="http://localhost:3001"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Server
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# RAG
OPENAI_API_KEY=""
QDRANT_URL="http://localhost:6333"

# Redis (required for job queue + embedding cache)
REDIS_URL="redis://localhost:6379"

# Monitoring (optional - leave empty to disable)
SENTRY_DSN=""

# Email (optional - magic links disabled if not set)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@corpusai.io"
