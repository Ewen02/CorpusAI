# ============================================
# CorpusAI Worker - Environment Variables
# ============================================

# Database
# Add pooling params in production (Railway/PgBouncer). The worker runs at
# concurrency 3, so a lower connection_limit than the API is enough.
DATABASE_URL="postgresql://user:password@localhost:5432/corpusai?schema=public&connection_limit=5&pool_timeout=20"

# Redis (required for job queue + embedding cache)
REDIS_URL="redis://localhost:6379"

# AI
OPENAI_API_KEY=""
QDRANT_URL="http://localhost:6333"

# Monitoring (optional - leave empty to disable)
SENTRY_DSN=""
