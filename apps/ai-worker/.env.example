# ============================================
# CorpusAI Worker - Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/corpusai?schema=public"

# Redis (required for job queue + embedding cache)
REDIS_URL="redis://localhost:6379"

# AI
OPENAI_API_KEY=""
QDRANT_URL="http://localhost:6333"

# Monitoring (optional - leave empty to disable)
SENTRY_DSN=""
