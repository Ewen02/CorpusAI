generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  image            String?
  emailVerified    Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  role             UserRole @default(USER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Public profile
  username String? @unique
  bio      String?

  // Subscription
  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  stripeCustomerId   String?            @unique

  // Preferences
  notificationPreferences Json?

  // Soft delete
  deletedAt DateTime?

  // Relations
  ais            AI[]
  sessions       Session[]
  accounts       Account[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  dailyStats     DailyStats[]
  collaborations AICollaborator[] @relation("UserCollaborations")
  invitesSent    AICollaborator[] @relation("InvitedByUser")

  @@index([email])
  @@index([username])
  @@index([stripeCustomerId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better Auth fields
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ============================================
// AI ASSISTANTS
// ============================================

model AI {
  id          String   @id @default(cuid())
  userId      String
  slug        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Configuration
  systemPrompt String?
  status       AIStatus   @default(DRAFT)
  category     AICategory @default(OTHER)
  language     String     @default("fr")

  // Settings (JSON for flexibility)
  welcomeMessage String?
  primaryColor   String  @default("#3b82f6")
  logo           String?
  maxTokens      Int     @default(1024)
  temperature    Float   @default(0.7)
  scoreThreshold Float   @default(0.4)
  llmModel       String  @default("gpt-4o-mini")
  // LLM provider: "openai" (default), "anthropic", "groq". Embeddings always stay on OpenAI.
  llmProvider    String  @default("openai")

  // Memory
  memoryEnabled Boolean @default(false)

  // Access & Monetization
  accessType AccessType @default(FREE)
  price      Float?
  isPublic   Boolean    @default(false)

  // Access control
  accessToken String? @unique
  accessCode  String?
  inviteOnly  Boolean @default(false)

  // Stats
  documentCount     Int @default(0)
  conversationCount Int @default(0)
  questionCount     Int @default(0)

  // Soft delete
  deletedAt DateTime?

  // Relations
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     Document[]
  conversations Conversation[]
  dailyStats    DailyStats[]
  accessGrants  AIAccessGrant[]
  memories      EndUserMemory[]
  collaborators AICollaborator[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([slug])
  @@index([status])
  @@index([isPublic, status])
  @@index([isPublic, status, conversationCount])
}

// ============================================
// DOCUMENTS & CHUNKS
// ============================================

model Document {
  id        String   @id @default(cuid())
  aiId      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // File info
  filename String
  mimeType String
  size     Int
  url      String?

  // Processing
  status       DocumentStatus @default(PENDING)
  chunkCount   Int            @default(0)
  errorMessage String?

  // Progress tracking
  processingProgress    Float           @default(0) // 0-100
  processingStep        ProcessingStep?
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?

  // Metadata (extracted from document)
  pageCount Int?
  wordCount Int?
  language  String?
  title     String?
  author    String?

  // Relations
  ai       AI                @relation(fields: [aiId], references: [id], onDelete: Cascade)
  chunks   Chunk[]
  versions DocumentVersion[]

  @@index([aiId, status])
  @@index([aiId])
  // Composite lookup used by the versioning flow to detect an existing active
  // document with the same filename for a given AI (re-upload triggers a new version).
  @@index([aiId, filename])
}

model DocumentVersion {
  id         String @id @default(cuid())
  documentId String
  version    Int

  // File info (snapshot at the time of the version)
  filename String
  mimeType String
  size     Int
  url      String?

  // Processing snapshot for the version
  chunkCount Int            @default(0)
  wordCount  Int?
  pageCount  Int?
  status     DocumentStatus @default(PENDING)

  uploadedAt DateTime @default(now())

  // Marks the version currently exposed to retrieval (Qdrant).
  isActive Boolean @default(false)

  // Extra metadata (title, author, language) extracted at version creation.
  metadata Json?

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   Chunk[]

  @@unique([documentId, version])
  @@index([documentId, isActive])
}

model Chunk {
  id                String   @id @default(cuid())
  documentId        String
  // Tag chunks with the version they belong to so rollback is a pointer flip:
  // we re-upsert chunks of the restored version into Qdrant rather than re-embedding.
  documentVersionId String?
  createdAt         DateTime @default(now())

  // Content
  content  String
  position Int

  // Location in source
  pageNumber Int?
  startChar  Int?
  endChar    Int?

  // Vector embedding stored in Qdrant (reference only)
  qdrantPointId String? @unique

  // Relations
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([documentVersionId])
  @@index([qdrantPointId])
}

// ============================================
// CONVERSATIONS & MESSAGES
// ============================================

model EndUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth magic link
  emailVerified    Boolean   @default(false)
  magicLinkToken   String?   @unique
  magicLinkExpires DateTime?

  // Session server-side
  sessionToken   String?   @unique
  sessionExpires DateTime?

  // Relations
  conversations Conversation[]
  accessGrants  AIAccessGrant[]
  memories      EndUserMemory[]

  @@index([email])
  @@index([magicLinkToken])
  @@index([sessionToken])
  @@index([sessionExpires])
  @@index([magicLinkExpires])
}

enum ConversationSource {
  DASHBOARD
  WIDGET
  PUBLIC
}

model Conversation {
  id        String   @id @default(cuid())
  aiId      String
  endUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title        String?
  messageCount Int                @default(0)
  source       ConversationSource @default(DASHBOARD)

  // Relations
  ai       AI        @relation(fields: [aiId], references: [id], onDelete: Cascade)
  endUser  EndUser?  @relation(fields: [endUserId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([aiId])
  @@index([endUserId])
  @@index([createdAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  createdAt      DateTime @default(now())

  // Content
  role    MessageRole
  content String

  // AI response metadata
  sources    Json?
  confidence ConfidenceLevel?
  tokenUsage Int? // Legacy total (kept for compat) — equals tokensIn + tokensOut
  tokensIn   Int? // Prompt tokens consumed by the LLM
  tokensOut  Int? // Completion tokens generated by the LLM
  cost       Float? // Estimated USD cost (computed at persistence with model pricing)
  model      String? // LLM model used (e.g. gpt-4o-mini) — pinned per-message for cost recomputation
  latencyMs  Int?

  // User feedback
  feedback String? // 'positive' | 'negative' | null

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  // Composite index for rate limiting queries (count messages by AI/date via conversation join)
  @@index([conversationId, role, createdAt])
  // Index for analytics aggregations on cost/tokens
  @@index([createdAt, role])
}

// ============================================
// END-USER MEMORY (multi-session context)
// ============================================

model EndUserMemory {
  id        String   @id @default(cuid())
  endUserId String
  aiId      String
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endUser EndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  ai      AI      @relation(fields: [aiId], references: [id], onDelete: Cascade)

  @@unique([endUserId, aiId])
  @@index([endUserId])
  @@index([aiId])
}

// ============================================
// AI COLLABORATORS (team collaboration)
// ============================================

model AICollaborator {
  id          String           @id @default(cuid())
  aiId        String
  userId      String?
  email       String
  role        CollaboratorRole @default(EDITOR)
  invitedBy   String
  invitedAt   DateTime         @default(now())
  acceptedAt  DateTime?
  inviteToken String?          @unique
  expiresAt   DateTime?

  ai      AI    @relation(fields: [aiId], references: [id], onDelete: Cascade)
  user    User? @relation("UserCollaborations", fields: [userId], references: [id], onDelete: Cascade)
  inviter User  @relation("InvitedByUser", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([aiId, userId])
  @@unique([aiId, email])
  @@index([aiId])
  @@index([userId])
  @@index([inviteToken])
}

enum CollaboratorRole {
  EDITOR
  VIEWER
}

// ============================================
// ACCESS GRANTS
// ============================================

model AIAccessGrant {
  id        String       @id @default(cuid())
  aiId      String
  endUserId String
  status    AccessStatus @default(ACTIVE)
  expiresAt DateTime?
  createdAt DateTime     @default(now())

  ai      AI      @relation(fields: [aiId], references: [id], onDelete: Cascade)
  endUser EndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@unique([aiId, endUserId])
  @@index([aiId])
  @@index([endUserId])
}

// ============================================
// ENUMS
// ============================================

enum AccessStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SubscriptionPlan {
  FREE
  CREATOR
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum AIStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AccessType {
  FREE
  PAID
  INVITE_ONLY
  TIME_LIMITED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum ProcessingStep {
  PARSING
  CHUNKING
  EMBEDDING
  STORING
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum UserRole {
  USER
  ADMIN
}

enum AICategory {
  SUPPORT
  EDUCATION
  LEGAL
  FINANCE
  HEALTH
  TECH
  OTHER
}

// ============================================
// API KEYS
// ============================================

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  prefix     String // First 8 chars for display (e.g., "cai_abc1...")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// ============================================
// WEBHOOKS
// ============================================

model Webhook {
  id     String   @id @default(cuid())
  userId String
  url    String
  events String[]
  secret String
  active Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastDeliveredAt DateTime?
  failureCount    Int       @default(0)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId, active])
}

model WebhookDelivery {
  id         String  @id @default(cuid())
  webhookId  String
  eventType  String
  payload    Json
  statusCode Int?
  attempt    Int     @default(1)
  success    Boolean @default(false)

  createdAt DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

// ============================================
// ANALYTICS
// ============================================

model DailyStats {
  id        String   @id @default(cuid())
  userId    String
  aiId      String?
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  // Métriques (valeurs cumulées à cette date)
  documentCount     Int @default(0)
  conversationCount Int @default(0)
  questionCount     Int @default(0)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ai   AI?  @relation(fields: [aiId], references: [id], onDelete: Cascade)

  @@unique([userId, aiId, date])
  @@index([userId, date])
  @@index([aiId, date])
}
