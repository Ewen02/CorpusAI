{
  "name": "@corpusai/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the CorpusAI API",
  "license": "MIT",
  "author": "CorpusAI",
  "keywords": [
    "corpusai",
    "rag",
    "ai",
    "chatbot",
    "embeddings",
    "vector-search",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ewenlq/corpusai.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://corpusai.io",
  "bugs": "https://github.com/ewenlq/corpusai/issues",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@corpusai/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
