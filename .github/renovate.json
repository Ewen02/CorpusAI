{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":automergeDigest",
    "schedule:weekly",
    "group:monorepos"
  ],
  "timezone": "Europe/Paris",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "groupName": "NestJS",
      "matchPackagePatterns": ["^@nestjs/"]
    },
    {
      "groupName": "React",
      "matchPackagePatterns": ["^react", "^@types/react"]
    },
    {
      "groupName": "Next.js",
      "matchPackageNames": ["next", "@next/eslint-plugin-next", "eslint-config-next"]
    },
    {
      "groupName": "Prisma",
      "matchPackagePatterns": ["^prisma", "^@prisma/"]
    },
    {
      "groupName": "Sentry",
      "matchPackagePatterns": ["^@sentry/"]
    },
    {
      "groupName": "TanStack",
      "matchPackagePatterns": ["^@tanstack/"]
    },
    {
      "groupName": "BullMQ",
      "matchPackageNames": ["bullmq", "ioredis"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchPackagePatterns": ["^@types/"],
      "automerge": true
    },
    {
      "matchPackageNames": ["node"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on monday"]
  }
}
